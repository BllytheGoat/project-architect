# Project Architect — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) -------------------------------------------------
# Local dev default (already configured on this machine):
#   DB name: project_architect, user: architect
DATABASE_URL=postgres://architect:architect@127.0.0.1:5432/project_architect

# --- Authentication --------------------------------------------------------
# Not used for credential auth, but reserved for future Supabase swap.
# SUPABASE_URL=
# SUPABASE_SECRET=

# --- AI provider (OpenAI-compatible) --------------------------------------
# Leave AI_API_KEY empty to force the deterministic mock provider (offline-safe).
# To use a real model, set a key; the app degrades to mock automatically if unset.
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_API_KEY=
AI_MODEL=agnes-3.0-flash
# Force the mock provider regardless of credentials:
# AI_PROVIDER=mock

# --- App -------------------------------------------------------------------
# A random secret for signing any server-side tokens you add later.
SESSION_SECRET=change-me-in-production
