# Project Architect — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) -------------------------------------------------
# The app resolves the connection in this priority order (db/env.ts):
#   1. DATABASE_URL            explicit, e.g. local dev
#   2. POSTGRES_URL_NON_POOLING  Supabase / Vercel-managed Postgres, direct (port 5432)
#   3. POSTGRES_URL            Vercel's pooled URL (port 6543) — last resort
# Local dev default (already configured on this machine):
#   DB name: project_architect, user: architect
DATABASE_URL=postgres://architect:***@127.0.0.1:5432/project_architect

# --- Supabase / Vercel-managed Postgres (used when DATABASE_URL is unset) ---
# When this app is deployed to Vercel and connected to a Supabase project,
# Vercel injects these automatically. Leave DATABASE_URL blank there and the
# app will use POSTGRES_URL_NON_POOLING (direct, correct for a `pg` pool).
#   POSTGRES_HOST / POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DATABASE
#   POSTGRES_URL / POSTGRES_URL_NON_POOLING / POSTGRES_PRISMA_URL
# TLS is enabled automatically for any non-local target.
#
# One-time schema bootstrap (only where the DB is reachable but your dev box
# isn't — Supabase's db host publishes no IPv4 A record). Set ADMIN_TOKEN,
# deploy, then:  curl -H "x-admin-token: $ADMIN_TOKEN" https://<app>/api/admin/apply-schema
# If ADMIN_TOKEN is unset the endpoint is disabled (503).
# ADMIN_TOKEN=

# --- AI provider (OpenAI-compatible) --------------------------------------
# Leave AI_API_KEY empty to force the deterministic mock provider (offline-safe).
# To use a real model, set a key; the app degrades to mock automatically if unset.
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_API_KEY=
AI_MODEL=agnes-3.0-flash
# Force the mock provider regardless of credentials:
# AI_PROVIDER=mock

# --- App -------------------------------------------------------------------
# A random secret for signing any server-side tokens you add later.
SESSION_SECRET=change-me-in-production
